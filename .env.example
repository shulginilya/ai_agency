# Auth for the agent itself. Note the missing AGENCY_ prefix: this is the variable the
# Claude Code CLI subprocess reads, and `Settings` declares it explicitly so that a value
# here actually reaches that subprocess.
#
# Set AT MOST ONE of the three below. They all work, they have a fixed precedence
# (bearer token > api key > oauth token), and setting two is silent: the loser is simply
# ignored, so a stale key left next to a new token keeps billing the old account. Check
# with `python tasks.py doctor` -- it names the winner and warns about the rest.
#
# Leave ALL of them blank only if you mean to use the `claude login` session on this
# machine. That fallback is silent and it expires: when it does, every run comes back as
# "Failed to authenticate: OAuth session expired and could not be refreshed".

# 1. Prepaid credits on a Claude Console account.
ANTHROPIC_API_KEY=
# 2. Your Claude subscription (Pro/Max/Team/Enterprise). Generate with `claude setup-token`;
#    lasts a year. Use this instead of an API key if you pay for a plan, not for credits.
CLAUDE_CODE_OAUTH_TOKEN=
# 3. Bearer token for an LLM gateway that fronts the API. Pair it with ANTHROPIC_BASE_URL.
ANTHROPIC_AUTH_TOKEN=

# Optional: point the CLI at a gateway or proxy. Blank => the public API.
ANTHROPIC_BASE_URL=

# Model selection
AGENCY_MODEL=claude-sonnet-5
AGENCY_EVAL_MODEL=claude-haiku-4-5-20251001

# Profile: dev | sandboxed | eval
AGENCY_PROFILE=dev

# Default team `agency team`/team-mode runs use when --team isn't given. See
# src/agency/agents/team.py:TEAMS for the registry (built-in: engineering).
AGENCY_DEFAULT_TEAM=engineering

# Safety rails
AGENCY_MAX_TURNS=40
AGENCY_MAX_BUDGET_USD=2.00

# Observability
AGENCY_LOG_LEVEL=INFO
AGENCY_LOG_FORMAT=console       # console | json
AGENCY_RUN_DIR=runs

# HTTP API (`agency serve`)
AGENCY_API_HOST=127.0.0.1       # 0.0.0.0 only inside a container
AGENCY_API_PORT=8000
# Blank => no auth. Set it to anything before this leaves your machine: the API runs
# arbitrary agent prompts, so an open one is remote code execution with a REST interface.
AGENCY_API_KEY=
# have your token here so you can hit claude SDK endpoints directly, without the AGENCY_ prefix. The agent itself reads this variable
CLAUDE_CODE_OAUTH_TOKEN=
# CORS. Leave both of the next two blank and no CORS middleware is installed at all --
# right for a loopback API with no browser client, and the usual reason a frontend cannot
# reach this one. Only browsers enforce any of this; curl is unaffected either way.
AGENCY_API_CORS_ORIGINS=        # comma-separated exact origins, e.g. http://localhost:3000
# Alternative, for origins that move: a dev server that changes port, a preview deploy per
# branch. Matched with fullmatch, so it needs no anchors -- but keep the tail tight, since
# `http://localhost:.*` would also match http://localhost:1@evil.example.
#   any localhost port:  http://(localhost|127\.0\.0\.1):\d{1,5}
AGENCY_API_CORS_ORIGIN_REGEX=
# Only for a cookie/session frontend. The X-API-Key and Bearer schemes above are not
# "credentials" in the CORS sense and do not need this. Incompatible with a wildcard
# origin -- set both and the wildcard wins, credentials are dropped with a warning.
AGENCY_API_CORS_ALLOW_CREDENTIALS=false
AGENCY_API_MAX_CONCURRENT_RUNS=4
AGENCY_API_RUN_TIMEOUT_S=300
AGENCY_API_QUEUE_TIMEOUT_S=0    # 0 = refuse with 503 rather than queue
# Multi-turn sessions (POST /v1/sessions). Each open session holds an SDK subprocess and a
# model context between requests, so the cap is on *open* sessions -- the turns themselves
# are still bounded by MAX_CONCURRENT_RUNS above.
AGENCY_API_MAX_SESSIONS=8
# Idle seconds before a session is reaped. A client that crashes mid-conversation never
# sends its DELETE. 0 disables reaping -- only sane if every client closes what it opens.
AGENCY_API_SESSION_IDLE_TTL_S=900
AGENCY_API_DOCS_ENABLED=true    # /docs, /redoc, /openapi.json

# --- Persistence (optional) ----------------------------------------------------------
# Unset => no database: capability packs come from src/agency/capabilities/seed.py, run
# records are JSON files under AGENCY_RUN_DIR, and live agent state is process-global.
# That is a supported mode, not a degraded one -- `agency run` and the eval suite must
# work in an image with no database driver installed.
#
# Set => packs, run history and agent state come from the database. Install the extra:
#   pip install -e ".[db]"        # SQLite
#   pip install -e ".[postgres]"  # + the Postgres driver
# Then migrate as a deploy step -- never on startup, or `uvicorn --workers N` becomes N
# processes racing one schema:
#   python tasks.py migrate
#
# AGENCY_DATABASE_URL=sqlite+aiosqlite:///agency.db
# AGENCY_DATABASE_URL=postgresql+asyncpg://agency:secret@localhost:5432/agency

# How long a resolved capability registry is reused before it is re-read. Cross-worker
# invalidation is this TTL and nothing cleverer; safe because a run pins revision ids at
# resolve time, so a stale cache means "the pack as it was N seconds ago", never a pack
# that never existed. 0 disables caching.
# AGENCY_CAPABILITY_CACHE_TTL_S=30

# Gate for the routes that CHANGE what agents may do. Deliberately not AGENCY_API_KEY:
# that credential authorises running agents, this one authorises widening their powers,
# and a leak of one is a different incident from a leak of the other. Unset => every
# mutating capability route 404s, so the safe configuration is the default one.
# AGENCY_ADMIN_API_KEY=
