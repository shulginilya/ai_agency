# Auth: either an API key, or leave blank to use an existing Claude Code login.
ANTHROPIC_API_KEY=

# Model selection
AGENCY_MODEL=claude-sonnet-5
AGENCY_EVAL_MODEL=claude-haiku-4-5-20251001

# Profile: dev | sandboxed | eval
AGENCY_PROFILE=dev

# Safety rails
AGENCY_MAX_TURNS=40
AGENCY_MAX_BUDGET_USD=2.00

# Observability
AGENCY_LOG_LEVEL=INFO
AGENCY_LOG_FORMAT=console       # console | json
AGENCY_RUN_DIR=runs

# HTTP API (`agency serve`)
AGENCY_API_HOST=127.0.0.1       # 0.0.0.0 only inside a container
AGENCY_API_PORT=8000
# Blank => no auth. Set it to anything before this leaves your machine: the API runs
# arbitrary agent prompts, so an open one is remote code execution with a REST interface.
AGENCY_API_KEY=
# CORS. Leave both of the next two blank and no CORS middleware is installed at all --
# right for a loopback API with no browser client, and the usual reason a frontend cannot
# reach this one. Only browsers enforce any of this; curl is unaffected either way.
AGENCY_API_CORS_ORIGINS=        # comma-separated exact origins, e.g. http://localhost:3000
# Alternative, for origins that move: a dev server that changes port, a preview deploy per
# branch. Matched with fullmatch, so it needs no anchors -- but keep the tail tight, since
# `http://localhost:.*` would also match http://localhost:1@evil.example.
#   any localhost port:  http://(localhost|127\.0\.0\.1):\d{1,5}
AGENCY_API_CORS_ORIGIN_REGEX=
# Only for a cookie/session frontend. The X-API-Key and Bearer schemes above are not
# "credentials" in the CORS sense and do not need this. Incompatible with a wildcard
# origin -- set both and the wildcard wins, credentials are dropped with a warning.
AGENCY_API_CORS_ALLOW_CREDENTIALS=false
AGENCY_API_MAX_CONCURRENT_RUNS=4
AGENCY_API_RUN_TIMEOUT_S=300
AGENCY_API_QUEUE_TIMEOUT_S=0    # 0 = refuse with 503 rather than queue
AGENCY_API_DOCS_ENABLED=true    # /docs, /redoc, /openapi.json
