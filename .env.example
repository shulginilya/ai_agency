# Auth: either an API key, or leave blank to use an existing Claude Code login.
ANTHROPIC_API_KEY=

# Model selection
AGENCY_MODEL=claude-sonnet-5
AGENCY_EVAL_MODEL=claude-haiku-4-5-20251001

# Profile: dev | sandboxed | eval
AGENCY_PROFILE=dev

# Safety rails
AGENCY_MAX_TURNS=40
AGENCY_MAX_BUDGET_USD=2.00

# Observability
AGENCY_LOG_LEVEL=INFO
AGENCY_LOG_FORMAT=console       # console | json
AGENCY_RUN_DIR=runs
